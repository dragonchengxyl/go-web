# 本地开发配置
# 用法: go run ./cmd/server/main.go -config configs/config.local.yaml
#
# 复制此文件: cp configs/config.local.yaml.example configs/config.local.yaml
# 此文件已被 gitignore，可以写入真实本地凭据

server:
  port: 8080
  mode: debug
  allow_origins:
    - http://localhost:3000
  frontend_url: http://localhost:3000

database:
  dsn: postgres://studio:password@localhost:5432/studio_db?sslmode=disable
  max_conns: 10
  min_conns: 2

redis:
  addr: localhost:6379
  password: ""
  db: 0

kafka:
  enabled: true
  brokers: localhost:9092
  topic: furry-events
  client_id: studio-platform-local
  read_min_bytes: 1024
  read_max_bytes: 10485760
  batch_timeout_ms: 1000
  start_offset: latest

jwt:
  secret: local-dev-secret-not-for-prod
  access_expiry: 60m
  refresh_expiry: 720h

oss:
  provider: aliyun
  access_key_id: ""
  access_key_secret: ""
  bucket: ""
  endpoint: ""
  region: ""
  allowed_hosts:
    - localhost
    - 127.0.0.1

ratelimit:
  unauthenticated: 60
  authenticated: 200
  admin: 1000

observability:
  stats_http_port: 18051
  notification_http_port: 18052
  moderation_http_port: 18053
  audio_worker_http_port: 18054
  outbox_http_port: 18055

email:
  host: localhost
  port: 1025        # MailHog: docker run -p 1025:1025 -p 8025:8025 mailhog/mailhog
  username: ""
  password: ""
  from: noreply@localhost

moderation:
  access_key_id: ""     # 留空则跳过内容审核
  access_key_secret: ""
  endpoint: green-cip.cn-shanghai.aliyuncs.com

payment:
  alipay:
    app_id: ""
    sandbox: true
  wechat:
    app_id: ""
    sandbox: true

sponsor:
  monthly_goal: 500
  current_raised: 123.45
  alipay_qr_url: ""
  wechat_qr_url: ""
  message: "【本地测试】感谢支持！"

audio:
  max_attempts: 3
  retry_backoff_sec: 10
  retry_poll_sec: 5
  retry_batch_size: 20

assistant:
  provider: deepseek
  base_url: https://api.deepseek.com/v1
  api_key: ""          # 例如: sk-xxxx
  model: deepseek-chat
  embedding_base_url: ""  # 例如: https://api.openai.com/v1
  embedding_api_key: ""
  embedding_model: text-embedding-3-small
  embedding_dims: 1536
  vision_base_url: ""
  vision_api_key: ""
  vision_model: gpt-4o-mini
  temperature: 0.7
  timeout_sec: 90
  vision_timeout_sec: 45
  max_context_items: 6
  persona_name: 霜牙
  retrieval_limit: 8
  vector_scan_limit: 1200
  sync_interval_sec: 600
  llm_retry_max: 2
  vision_retry_max: 2
  circuit_failures: 3
  circuit_open_sec: 60
  media_cache_ttl_sec: 86400
