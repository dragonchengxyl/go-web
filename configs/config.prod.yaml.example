# 生产环境配置模板
# 用法:
#   cp configs/config.prod.yaml.example configs/config.prod.yaml
#   然后填入真实生产值
#
# 注意:
# - `configs/config.prod.yaml` 已被 gitignore，不要提交真实凭据
# - 所有字段都可以被 `STUDIO_*` 环境变量覆盖
# - 这里仅保留当前代码真实支持的配置项

server:
  port: 8080
  mode: release
  allow_origins:
    - https://app.example.com
  frontend_url: https://app.example.com

database:
  dsn: postgres://studio:CHANGE_ME@db.example.com:5432/studio_prod?sslmode=require
  max_conns: 30
  min_conns: 5

redis:
  addr: redis.example.com:6379
  password: CHANGE_ME
  db: 0

kafka:
  enabled: true
  brokers: kafka-1.example.com:9092,kafka-2.example.com:9092,kafka-3.example.com:9092
  topic: furry-events
  client_id: studio-platform-prod
  read_min_bytes: 1024
  read_max_bytes: 10485760
  batch_timeout_ms: 1000
  start_offset: latest

jwt:
  # 例如: openssl rand -base64 48
  secret: CHANGE_ME_LONG_RANDOM_SECRET
  access_expiry: 15m
  refresh_expiry: 720h

oss:
  # local | aliyun | r2
  provider: r2
  access_key_id: CHANGE_ME
  access_key_secret: CHANGE_ME
  bucket: furry-community-prod
  endpoint: https://<account_id>.r2.cloudflarestorage.com
  region: auto
  allowed_hosts:
    - cdn.example.com
    - pub-<bucket>.r2.dev

ratelimit:
  unauthenticated: 60
  authenticated: 200
  admin: 1000

observability:
  stats_http_port: 18051
  notification_http_port: 18052
  moderation_http_port: 18053
  audio_worker_http_port: 18054
  outbox_http_port: 18055

email:
  host: smtp.example.com
  port: 587
  username: noreply@example.com
  password: CHANGE_ME
  from: noreply@example.com

moderation:
  # 不启用可留空
  access_key_id: ""
  access_key_secret: ""
  endpoint: green-cip.cn-shanghai.aliyuncs.com

payment:
  alipay:
    app_id: ""
    private_key: ""
    public_key: ""
    notify_url: https://api.example.com/api/v1/payment/callback/alipay
    sandbox: false
  wechat:
    app_id: ""
    mch_id: ""
    api_key: ""
    notify_url: https://api.example.com/api/v1/payment/callback/wechat
    sandbox: false

sponsor:
  monthly_goal: 5000
  current_raised: 0
  alipay_qr_url: ""
  wechat_qr_url: ""
  message: "感谢支持社区创作与运营。"

grpc:
  # 主 API 作为 client 时使用，留空表示走本地实现或未启用
  stats_addr: ""
  notification_addr: ""
  moderation_addr: ""
  # 独立服务监听端口
  stats_port: 50051
  notification_port: 50052
  moderation_port: 50053

audio:
  max_attempts: 3
  retry_backoff_sec: 10
  retry_poll_sec: 5
  retry_batch_size: 20

assistant:
  provider: deepseek
  base_url: https://api.deepseek.com/v1
  api_key: ""
  model: deepseek-chat
  embedding_base_url: ""
  embedding_api_key: ""
  embedding_model: text-embedding-3-small
  embedding_dims: 1536
  vision_base_url: ""
  vision_api_key: ""
  vision_model: gpt-4o-mini
  temperature: 0.6
  timeout_sec: 90
  vision_timeout_sec: 45
  max_context_items: 6
  persona_name: 霜牙
  retrieval_limit: 8
  vector_scan_limit: 1200
  sync_interval_sec: 600
  llm_retry_max: 2
  vision_retry_max: 2
  circuit_failures: 3
  circuit_open_sec: 60
  media_cache_ttl_sec: 86400
