# Image references built by CI
BACKEND_IMAGE=ghcr.io/OWNER/REPO/backend:main
FRONTEND_IMAGE=ghcr.io/OWNER/REPO/frontend:main
KAFKA_IMAGE=ghcr.io/OWNER/REPO/kafka:main

# Local-only host ports used before Nginx cutover
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379
BACKEND_HOST_PORT=18080
FRONTEND_HOST_PORT=13000

# Containerized database
POSTGRES_DB=studio_db
POSTGRES_USER=studio
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# Containerized Redis
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# Core backend config
STUDIO_SERVER_PORT=8080
STUDIO_SERVER_MODE=release
STUDIO_SERVER_ALLOW_ORIGINS=http://YOUR_PUBLIC_IP
STUDIO_SERVER_FRONTEND_URL=http://YOUR_PUBLIC_IP
STUDIO_DATABASE_DSN=postgres://studio:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/studio_db?sslmode=disable
STUDIO_DATABASE_MAX_CONNS=20
STUDIO_DATABASE_MIN_CONNS=5
STUDIO_REDIS_ADDR=redis:6379
STUDIO_REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
STUDIO_REDIS_DB=0
STUDIO_KAFKA_ENABLED=true
STUDIO_KAFKA_BROKERS=kafka:9092
STUDIO_KAFKA_TOPIC=furry-events
STUDIO_KAFKA_CLIENT_ID=studio-platform-prod
STUDIO_KAFKA_READ_MIN_BYTES=1024
STUDIO_KAFKA_READ_MAX_BYTES=10485760
STUDIO_KAFKA_BATCH_TIMEOUT_MS=1000
STUDIO_KAFKA_START_OFFSET=latest
STUDIO_OBSERVABILITY_STATS_HTTP_PORT=18051
STUDIO_OBSERVABILITY_NOTIFICATION_HTTP_PORT=18052
STUDIO_OBSERVABILITY_MODERATION_HTTP_PORT=18053
STUDIO_OBSERVABILITY_AUDIO_WORKER_HTTP_PORT=18054
STUDIO_OBSERVABILITY_OUTBOX_HTTP_PORT=18055
STUDIO_JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
STUDIO_JWT_ACCESS_EXPIRY=15m
STUDIO_JWT_REFRESH_EXPIRY=720h

# Frontend runtime config
NEXT_PUBLIC_SITE_URL=http://YOUR_PUBLIC_IP
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_WS_URL=

# One-shot seed task defaults
SEED_MODE=bulk
SEED_PROFILE=medium
SEED_NAMESPACE=bulk
SEED_RANDOM_SEED=0

# Optional storage / email / payment / AI config
STUDIO_OSS_PROVIDER=local
STUDIO_OSS_ACCESS_KEY_ID=
STUDIO_OSS_ACCESS_KEY_SECRET=
STUDIO_OSS_BUCKET=
STUDIO_OSS_ENDPOINT=
STUDIO_OSS_REGION=
STUDIO_OSS_ALLOWED_HOSTS=

STUDIO_EMAIL_HOST=
STUDIO_EMAIL_PORT=587
STUDIO_EMAIL_USERNAME=
STUDIO_EMAIL_PASSWORD=
STUDIO_EMAIL_FROM=

STUDIO_MODERATION_ACCESS_KEY_ID=
STUDIO_MODERATION_ACCESS_KEY_SECRET=
STUDIO_MODERATION_ENDPOINT=green-cip.cn-shanghai.aliyuncs.com

STUDIO_PAYMENT_ALIPAY_APP_ID=
STUDIO_PAYMENT_ALIPAY_PRIVATE_KEY=
STUDIO_PAYMENT_ALIPAY_PUBLIC_KEY=
STUDIO_PAYMENT_ALIPAY_NOTIFY_URL=
STUDIO_PAYMENT_ALIPAY_SANDBOX=false
STUDIO_PAYMENT_WECHAT_APP_ID=
STUDIO_PAYMENT_WECHAT_MCH_ID=
STUDIO_PAYMENT_WECHAT_API_KEY=
STUDIO_PAYMENT_WECHAT_NOTIFY_URL=
STUDIO_PAYMENT_WECHAT_SANDBOX=false

STUDIO_ASSISTANT_PROVIDER=deepseek
STUDIO_ASSISTANT_BASE_URL=https://api.deepseek.com/v1
STUDIO_ASSISTANT_API_KEY=
STUDIO_ASSISTANT_MODEL=deepseek-chat
STUDIO_ASSISTANT_EMBEDDING_BASE_URL=
STUDIO_ASSISTANT_EMBEDDING_API_KEY=
STUDIO_ASSISTANT_EMBEDDING_MODEL=text-embedding-3-small
STUDIO_ASSISTANT_EMBEDDING_DIMS=1536
STUDIO_ASSISTANT_VISION_BASE_URL=
STUDIO_ASSISTANT_VISION_API_KEY=
STUDIO_ASSISTANT_VISION_MODEL=gpt-4o-mini
STUDIO_ASSISTANT_TEMPERATURE=0.6
STUDIO_ASSISTANT_TIMEOUT_SEC=90
STUDIO_ASSISTANT_VISION_TIMEOUT_SEC=45
STUDIO_ASSISTANT_MAX_CONTEXT_ITEMS=6
STUDIO_ASSISTANT_PERSONA_NAME=霜牙
STUDIO_ASSISTANT_RETRIEVAL_LIMIT=8
STUDIO_ASSISTANT_VECTOR_SCAN_LIMIT=1200
STUDIO_ASSISTANT_SYNC_INTERVAL_SEC=600
STUDIO_ASSISTANT_LLM_RETRY_MAX=2
STUDIO_ASSISTANT_VISION_RETRY_MAX=2
STUDIO_ASSISTANT_CIRCUIT_FAILURES=3
STUDIO_ASSISTANT_CIRCUIT_OPEN_SEC=60
STUDIO_ASSISTANT_MEDIA_CACHE_TTL_SEC=86400
